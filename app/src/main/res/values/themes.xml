<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.XEDigital" parent="Theme.MaterialComponents.DayNight.DarkActionBar">

        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryVariant</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorSecondaryVariant">@color/colorSecondaryVariant</item>
        <item name="colorOnSecondary">@color/black</item>

        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
        <item name="android:windowBackground">@color/background</item>

        <item name="fontFamily">@font/quicksand_font_family</item>

        <item name="subMenuArrow">@drawable/ic_dropdown_adaptive_fore</item>
        <item name="android:groupIndicator">@drawable/ic_dropdown_adaptive_fore</item>
        <item name="android:itemBackground">@color/submenu_background</item>
    </style>

    <style name="Theme.XEDigital.NoActionBar" parent="Theme.XEDigital">

        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.XEDigital.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.XEDigital.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="ThemeOverlay.App.BottomSheetDialog" parent="ThemeOverlay.MaterialComponents.BottomSheetDialog">

        <item name="bottomSheetStyle">@style/Widget.App.BottomSheet.Modal</item>
    </style>

    <style name="Widget.App.BottomSheet.Modal" parent="Widget.MaterialComponents.BottomSheet.Modal">

        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="CircleImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
    <!-- Navigation Drawer Item Text Style with Quicksand Font -->
    <style name="NavDrawerItemTextAppearance" parent="TextAppearance.MaterialComponents.Body1">
        <item name="fontFamily">@font/quicksand_font_family</item>
        <item name="android:fontFamily">@font/quicksand_font_family</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Navigation Drawer Sub-Header / Group Title Style -->
    <style name="NavDrawerGroupTextAppearance" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="fontFamily">@font/quicksand_font_family</item>
        <item name="android:fontFamily">@font/quicksand_font_family</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>
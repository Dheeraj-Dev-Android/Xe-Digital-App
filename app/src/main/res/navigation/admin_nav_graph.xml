<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/admin_nav_graph"
    app:startDestination="@id/nav_admin_dashboard">

    <fragment
        android:id="@+id/nav_admin_dashboard"
        android:name="app.xedigital.ai.admin.adminUI.adminDashboard.AdminDashboardFragment"
        android:label="Dashboard"
        tools:layout="@layout/fragment_admin_dashboard">
        <action
            android:id="@+id/action_dashboard_to_visitorCheckIn"
            app:destination="@id/nav_visitorCheckInFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />
        <action
            android:id="@+id/action_dashboard_to_visitorDetails"
            app:destination="@id/nav_visitorDetailsFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />
    </fragment>

    <fragment
        android:id="@+id/nav_visitorCheckInFragment"
        android:name="app.xedigital.ai.admin.adminUI.Visitor.VisitorCheckInFragment"
        android:label="Visitor Check-In"
        tools:layout="@layout/fragment_visitor_check_in">
        <action
            android:id="@+id/action_visitorCheckIn_to_visitorDetails"
            app:destination="@id/nav_visitorDetailsFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />
        <action
            android:id="@+id/action_visitorCheckIn_to_nav_admin_dashboard"
            app:destination="@id/nav_admin_dashboard"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />
    </fragment>

    <fragment
        android:id="@+id/nav_employees"
        android:name="app.xedigital.ai.admin.adminUI.employeeDetails.EmployeeDetailsFragment"
        android:label="Employees"
        tools:layout="@layout/fragment_employee_details">
        <action
            android:id="@+id/nav_employees_to_nav_editEmployee"
            app:destination="@id/nav_editEmployee" />
        <action
            android:id="@+id/nav_employees_to_nav_addFace"
            app:destination="@id/nav_addFace"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />
        <action
            android:id="@+id/nav_employees_to_nav_createNewEmployee"
            app:destination="@id/nav_createNewEmployee"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />
    </fragment>

    <fragment
        android:id="@+id/nav_createNewEmployee"
        android:name="app.xedigital.ai.admin.adminUI.employeeDetails.CreateNewEmployeeFragment"
        android:label="Create New Employee"
        tools:layout="@layout/fragment_create_new_employee">
        <action
            android:id="@+id/action_nav_createNewEmployee_to_nav_employees"
            app:destination="@id/nav_employees" />
    </fragment>

    <fragment
        android:id="@+id/nav_addFace"
        android:name="app.xedigital.ai.admin.adminUI.employeeDetails.AddFaceFragment"
        android:label="Add Face"
        tools:layout="@layout/fragment_add_face" />

    <fragment
        android:id="@+id/nav_visitorDetailsFragment"
        android:name="app.xedigital.ai.admin.adminUI.Visitor.VisitorsDetailsFragment"
        android:label="Visitor Details"
        tools:layout="@layout/fragment_visitors_details" />

    <fragment
        android:id="@+id/nav_partners"
        android:name="app.xedigital.ai.admin.adminUI.partners.PartnersFragment"
        android:label="Partners"
        tools:layout="@layout/fragment_partners" />

    <fragment
        android:id="@+id/nav_allUsers"
        android:name="app.xedigital.ai.admin.adminUI.allUsers.AllUsersFragment"
        android:label="All Users"
        tools:layout="@layout/fragment_all_users">
        <action
            android:id="@+id/nav_allUsers_to_nav_editUser"
            app:destination="@id/nav_editUser" />
        <action
            android:id="@+id/action_allUsersFragment_to_addUserFragment"
            app:destination="@id/addUserFragment" />
    </fragment>

    <fragment
        android:id="@+id/nav_editUser"
        android:name="app.xedigital.ai.admin.adminUI.allUsers.EditUserFragment"
        android:label="Edit User"
        tools:layout="@layout/fragment_edit_user">
        <action
            android:id="@+id/nav_editUser_to_nav_allUsers"
            app:destination="@id/nav_allUsers" />
    </fragment>

    <fragment
        android:id="@+id/addUserFragment"
        android:name="app.xedigital.ai.admin.adminUI.allUsers.AddUserFragment"
        android:label="Add New User"
        tools:layout="@layout/fragment_add_user">
        <action
            android:id="@+id/action_addUserFragment_to_nav_allUsers"
            app:destination="@id/nav_allUsers" />
    </fragment>
    <fragment
        android:id="@+id/nav_editEmployee"
        android:name="app.xedigital.ai.admin.adminUI.employeeDetails.EditEmployeeFragment"
        android:label="Edit Employee"
        tools:layout="@layout/fragment_edit_employee">
        <action
            android:id="@+id/nav_editEmployee_to_nav_employees"
            app:destination="@id/nav_employees" />
    </fragment>

    <fragment
        android:id="@+id/nav_employee_onboard_details"
        android:name="app.xedigital.ai.admin.adminUI.employeeOnboard.EmployeeOnboardDetailsFragment"
        android:label="Employee Onboard Details"
        tools:layout="@layout/fragment_employee_onboard_details">
        <action
            android:id="@+id/action_nav_employeeOnboardDetails_to_nav_admin_dashboard"
            app:destination="@id/nav_admin_dashboard" />
    </fragment>

    <fragment
        android:id="@+id/nav_employee_attendance"
        android:name="app.xedigital.ai.admin.adminUI.EmployeeAttendance.EmployeeAttendanceFragment"
        android:label="Employee Attendance"
        tools:layout="@layout/fragment_employee_attendance">
        <action
            android:id="@+id/action_nav_employee_attendance_to_nav_admin_dashboard"
            app:destination="@id/nav_admin_dashboard" />
        <action
            android:id="@+id/action_nav_employee_attendance_to_nav_attendance_regularization_approval"
            app:destination="@id/nav_attendance_regularization_approval" />
        <action
            android:id="@+id/action_nav_employee_attendance_to_nav_add_attendance_pending_approval"
            app:destination="@id/nav_add_attendance_pending_approval" />
    </fragment>
    <fragment
        android:id="@+id/nav_attendance_regularization_approval"
        android:name="app.xedigital.ai.admin.adminUI.EmployeeAttendance.AttendanceRegularizationApprovalFragment"
        android:label="Attendance Regularization Approval"
        tools:layout="@layout/fragment_attendance_regularization_approval">
        <action
            android:id="@+id/action_nav_attendance_regularization_approval_to_nav_employee_attendance"
            app:destination="@id/nav_employee_attendance" />
        <action
            android:id="@+id/action_nav_attendance_regularization_approval_to_nav_admin_dashboard"
            app:destination="@id/nav_admin_dashboard" />
    </fragment>
    <fragment
        android:id="@+id/nav_add_attendance_pending_approval"
        android:name="app.xedigital.ai.admin.adminUI.EmployeeAttendance.AddAttendancePendingApprovalFragment"
        android:label="Add Attendance Pending Approval"
        tools:layout="@layout/fragment_add_attendance_pending_approval">
        <action
            android:id="@+id/action_nav_add_attendance_pending_approval_to_nav_employee_attendance"
            app:destination="@id/nav_employee_attendance" />
        <action
            android:id="@+id/action_nav_add_attendance_pending_approval_to_nav_admin_dashboard"
            app:destination="@id/nav_admin_dashboard" />
    </fragment>

</navigation>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fragment_dashboard_bg"
    tools:context=".admin.adminUI.employeeOnboard.EmployeeOnboardDetailsFragment">

    <!-- Search Bar -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/searchCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeColor="#ECEFF3"
        app:strokeWidth="1dp">

        <EditText
            android:id="@+id/etSearchOnboard"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="10dp"
            android:hint="Search by name..."
            android:imeOptions="actionSearch"
            android:inputType="textPersonName"
            android:maxLines="1"
            android:paddingHorizontal="14dp"
            android:textColor="#1C1E29"
            android:textColorHint="#8A8A8A"
            android:textSize="14sp" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Real List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvOnboardEmployees"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:padding="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/searchCard" />

    <!-- Inline Shimmer Loader -->
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmerLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingTop="8dp"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/searchCard"
        app:shimmer_auto_start="true"
        app:shimmer_base_alpha="0.7"
        app:shimmer_duration="1200"
        app:shimmer_highlight_alpha="1.0">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Card 1 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginVertical="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#ECEFF3"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="54dp"
                            android:layout_height="54dp"
                            android:background="@drawable/bg_shimmer_circle" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <View
                                android:layout_width="60dp"
                                android:layout_height="10dp"
                                android:background="@drawable/bg_shimmer_rect" />

                            <View
                                android:layout_width="140dp"
                                android:layout_height="14dp"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/bg_shimmer_rect" />

                            <View
                                android:layout_width="180dp"
                                android:layout_height="12dp"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/bg_shimmer_rect" />
                        </LinearLayout>

                        <View
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_shimmer_circle" />

                        <View
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_shimmer_circle" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:background="#ECEFF3" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <View
                                android:layout_width="50dp"
                                android:layout_height="10dp"
                                android:background="@drawable/bg_shimmer_rect" />

                            <View
                                android:layout_width="100dp"
                                android:layout_height="12dp"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/bg_shimmer_rect" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="8dp">

                            <View
                                android:layout_width="70dp"
                                android:layout_height="10dp"
                                android:background="@drawable/bg_shimmer_rect" />

                            <View
                                android:layout_width="90dp"
                                android:layout_height="12dp"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/bg_shimmer_rect" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <View
                                android:layout_width="50dp"
                                android:layout_height="10dp"
                                android:background="@drawable/bg_shimmer_rect" />

                            <View
                                android:layout_width="100dp"
                                android:layout_height="12dp"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/bg_shimmer_rect" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="8dp">

                            <View
                                android:layout_width="70dp"
                                android:layout_height="10dp"
                                android:background="@drawable/bg_shimmer_rect" />

                            <View
                                android:layout_width="90dp"
                                android:layout_height="12dp"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/bg_shimmer_rect" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginVertical="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#ECEFF3"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="54dp"
                            android:layout_height="54dp"
                            android:background="@drawable/bg_shimmer_circle" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <View
                                android:layout_width="60dp"
                                android:layout_height="10dp"
                                android:background="@drawable/bg_shimmer_rect" />

                            <View
                                android:layout_width="140dp"
                                android:layout_height="14dp"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/bg_shimmer_rect" />

                            <View
                                android:layout_width="180dp"
                                android:layout_height="12dp"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/bg_shimmer_rect" />
                        </LinearLayout>

                        <View
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_shimmer_circle" />

                        <View
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_shimmer_circle" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:background="#ECEFF3" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <View
                                android:layout_width="50dp"
                                android:layout_height="10dp"
                                android:background="@drawable/bg_shimmer_rect" />

                            <View
                                android:layout_width="100dp"
                                android:layout_height="12dp"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/bg_shimmer_rect" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="8dp">

                            <View
                                android:layout_width="70dp"
                                android:layout_height="10dp"
                                android:background="@drawable/bg_shimmer_rect" />

                            <View
                                android:layout_width="90dp"
                                android:layout_height="12dp"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/bg_shimmer_rect" />
                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <View
                                android:layout_width="50dp"
                                android:layout_height="10dp"
                                android:background="@drawable/bg_shimmer_rect" />

                            <View
                                android:layout_width="100dp"
                                android:layout_height="12dp"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/bg_shimmer_rect" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="8dp">

                            <View
                                android:layout_width="70dp"
                                android:layout_height="10dp"
                                android:background="@drawable/bg_shimmer_rect" />

                            <View
                                android:layout_width="90dp"
                                android:layout_height="12dp"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/bg_shimmer_rect" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 3 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginVertical="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#ECEFF3"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="54dp"
                            android:layout_height="54dp"
                            android:background="@drawable/bg_shimmer_circle" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <View
                                android:layout_width="60dp"
                                android:layout_height="10dp"
                                android:background="@drawable/bg_shimmer_rect" />

                            <View
                                android:layout_width="140dp"
                                android:layout_height="14dp"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/bg_shimmer_rect" />

                            <View
                                android:layout_width="180dp"
                                android:layout_height="12dp"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/bg_shimmer_rect" />
                        </LinearLayout>

                        <View
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_shimmer_circle" />

                        <View
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_shimmer_circle" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:background="#ECEFF3" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <View
                                android:layout_width="50dp"
                                android:layout_height="10dp"
                                android:background="@drawable/bg_shimmer_rect" />

                            <View
                                android:layout_width="100dp"
                                android:layout_height="12dp"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/bg_shimmer_rect" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="8dp">

                            <View
                                android:layout_width="70dp"
                                android:layout_height="10dp"
                                android:background="@drawable/bg_shimmer_rect" />

                            <View
                                android:layout_width="90dp"
                                android:layout_height="12dp"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/bg_shimmer_rect" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <View
                                android:layout_width="50dp"
                                android:layout_height="10dp"
                                android:background="@drawable/bg_shimmer_rect" />

                            <View
                                android:layout_width="100dp"
                                android:layout_height="12dp"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/bg_shimmer_rect" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="8dp">

                            <View
                                android:layout_width="70dp"
                                android:layout_height="10dp"
                                android:background="@drawable/bg_shimmer_rect" />

                            <View
                                android:layout_width="90dp"
                                android:layout_height="12dp"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/bg_shimmer_rect" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/emptyStateView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/searchCard">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No records found"
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
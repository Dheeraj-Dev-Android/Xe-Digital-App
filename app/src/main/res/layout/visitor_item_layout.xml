<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardViewVisitor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="12dp"
            app:cardElevation="3dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeWidth="0dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- ================= HEADER (gradient banner) ================= -->

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/headerContainer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/gradient_attendance_card"
                    android:padding="12dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/ivVisitorProfile"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/circular_background"
                        android:importantForAccessibility="no"
                        android:padding="3dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvVisitorName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="8dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@id/chipApprovalStatus"
                        app:layout_constraintStart_toEndOf="@id/ivVisitorProfile"
                        app:layout_constraintTop_toTopOf="@id/ivVisitorProfile"
                        tools:text="Visitor Name" />

                    <TextView
                        android:id="@+id/tvVisitorSubtitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="2dp"
                        android:alpha="0.7"
                        android:text="Guest Visitor"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        app:layout_constraintEnd_toStartOf="@id/chipApprovalStatus"
                        app:layout_constraintStart_toEndOf="@id/ivVisitorProfile"
                        app:layout_constraintTop_toBottomOf="@id/tvVisitorName" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipApprovalStatus"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:chipCornerRadius="14dp"
                        app:chipMinHeight="26dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:text="Approved" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- ================= BODY CONTENT ================= -->

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:padding="14dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/headerContainer">

                    <!-- Guideline splits body into two equal columns -->
                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/guidelineMid"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintGuide_percent="0.5" />

                    <!-- ============ CONTACT INFORMATION ============ -->

                    <View
                        android:id="@+id/accentBarContact"
                        android:layout_width="4dp"
                        android:layout_height="11dp"
                        android:background="@color/colorPrimary"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvContactInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:letterSpacing="0.04"
                        android:text="Contact Information"
                        android:textAllCaps="true"
                        android:textColor="@color/colorPrimary"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="@id/accentBarContact"
                        app:layout_constraintStart_toEndOf="@id/accentBarContact"
                        app:layout_constraintTop_toTopOf="@id/accentBarContact" />

                    <!-- Email: left column -->
                    <TextView
                        android:id="@+id/tvEmailLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:alpha="0.8"
                        android:text="Email Address"
                        android:textColor="@color/text_secondary"
                        android:textSize="10.5sp"
                        app:layout_constraintEnd_toStartOf="@id/guidelineMid"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/accentBarContact" />

                    <TextView
                        android:id="@+id/tvEmail"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:layout_marginEnd="6dp"
                        android:drawablePadding="6dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:drawableStartCompat="@drawable/ic_email"
                        app:drawableTint="@color/colorPrimary"
                        app:layout_constraintEnd_toStartOf="@id/guidelineMid"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvEmailLabel"
                        tools:text="visitor@example.com" />

                    <!-- Phone: right column -->
                    <TextView
                        android:id="@+id/tvContactLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_marginTop="10dp"
                        android:alpha="0.8"
                        android:text="Phone Number"
                        android:textColor="@color/text_secondary"
                        android:textSize="10.5sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/guidelineMid"
                        app:layout_constraintTop_toBottomOf="@id/accentBarContact" />

                    <TextView
                        android:id="@+id/tvContact"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_marginTop="3dp"
                        android:drawableStart="@drawable/ic_phone"
                        android:drawablePadding="6dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:drawableTint="@color/colorPrimary"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/guidelineMid"
                        app:layout_constraintTop_toBottomOf="@id/tvContactLabel"
                        tools:text="+91234567890" />

                    <!-- Barrier aligns divider2 below the taller of email/phone -->
                    <androidx.constraintlayout.widget.Barrier
                        android:id="@+id/contactRowBarrier"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:barrierDirection="bottom"
                        app:constraint_referenced_ids="tvEmail,tvContact" />

                    <View
                        android:id="@+id/divider2"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_marginTop="6dp"
                        android:alpha="0.5"
                        android:background="@color/divider_color"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/contactRowBarrier" />

                    <!-- ============ MEETING DETAILS ============ -->

                    <View
                        android:id="@+id/accentBarMeeting"
                        android:layout_width="4dp"
                        android:layout_height="11dp"
                        android:layout_marginTop="12dp"
                        android:background="@color/colorPrimary"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/divider2" />

                    <TextView
                        android:id="@+id/tvMeetingDetails"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:letterSpacing="0.04"
                        android:text="Meeting Details"
                        android:textAllCaps="true"
                        android:textColor="@color/colorPrimary"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="@id/accentBarMeeting"
                        app:layout_constraintStart_toEndOf="@id/accentBarMeeting"
                        app:layout_constraintTop_toTopOf="@id/accentBarMeeting" />

                    <!-- Company: left column -->
                    <TextView
                        android:id="@+id/tvCompanyFromLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:alpha="0.8"
                        android:text="Visiting From"
                        android:textColor="@color/text_secondary"
                        android:textSize="10.5sp"
                        app:layout_constraintEnd_toStartOf="@id/guidelineMid"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/accentBarMeeting" />

                    <TextView
                        android:id="@+id/tvCompanyFrom"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:layout_marginEnd="6dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@id/guidelineMid"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvCompanyFromLabel"
                        tools:text="XeDigital.ai" />

                    <!-- Meeting With: right column -->
                    <TextView
                        android:id="@+id/tvMeetingWithLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_marginTop="10dp"
                        android:alpha="0.8"
                        android:text="Meeting With"
                        android:textColor="@color/text_secondary"
                        android:textSize="10.5sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/guidelineMid"
                        app:layout_constraintTop_toBottomOf="@id/accentBarMeeting" />

                    <TextView
                        android:id="@+id/tvMeetingWith"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_marginTop="3dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/guidelineMid"
                        app:layout_constraintTop_toBottomOf="@id/tvMeetingWithLabel"
                        tools:text="XeDigital.ai" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/addedAttendanceCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:rippleColor="#1A4F46E5"
    app:strokeColor="#ECEFF3"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- ===== TOP SECTION: Avatar + Name + Email ===== -->

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/topSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Avatar with tinted background -->
            <FrameLayout
                android:id="@+id/avatarFrame"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_icon_square"
                android:backgroundTint="#E6F4FF"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/avatar"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:contentDescription="Employee Image"
                    android:padding="10dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_person"
                    app:shapeAppearanceOverlay="@style/CircularImageView" />

            </FrameLayout>

            <!-- Employee Name -->
            <TextView
                android:id="@+id/empName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#1C1E29"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/avatarFrame"
                app:layout_constraintTop_toTopOf="@id/avatarFrame"
                tools:text="XeDigital.ai" />

            <!-- Email / Sub Label -->
            <TextView
                android:id="@+id/subLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="3dp"
                android:layout_marginEnd="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="email"
                android:textColor="#6B7280"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/avatarFrame"
                app:layout_constraintTop_toBottomOf="@id/empName" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ===== DIVIDER ===== -->

        <com.google.android.material.divider.MaterialDivider
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:dividerColor="#F0F1F5"
            app:dividerThickness="1dp"
            app:layout_constraintTop_toBottomOf="@id/topSection" />

        <!-- ===== INFO SECTION: Applied Date + Punch Date ===== -->

        <LinearLayout
            android:id="@+id/infoSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp"
            app:layout_constraintTop_toBottomOf="@id/divider">

            <!-- Applied Date -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Calendar Icon in tinted square -->
                <FrameLayout
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_icon_square"
                    android:backgroundTint="#FFF9DB">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_calendar"
                        app:tint="#D97706" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.04"
                        android:text="APPLIED DATE"
                        android:textColor="#6B7280"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/appliedDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="#1C1E29"
                        android:textSize="13.5sp"
                        android:textStyle="bold"
                        tools:text="12 Jan 2024" />
                </LinearLayout>
            </LinearLayout>

            <!-- Punch Date -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Clock Icon in tinted square -->
                <FrameLayout
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_icon_square"
                    android:backgroundTint="#E7F9EF">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_clock"
                        app:tint="#059669" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.04"
                        android:text="PUNCH DATE"
                        android:textColor="#6B7280"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/empPunchDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="#1C1E29"
                        android:textSize="13.5sp"
                        android:textStyle="bold"
                        tools:text="12 Jan, 09:15 AM" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

        <!-- ===== BOTTOM DIVIDER ===== -->

        <com.google.android.material.divider.MaterialDivider
            android:id="@+id/bottomDivider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:dividerColor="#F0F1F5"
            app:dividerThickness="1dp"
            app:layout_constraintTop_toBottomOf="@id/infoSection" />

        <!-- ===== BOTTOM ROW: Status Chip + View Details Button ===== -->

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bottomRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp"
            app:layout_constraintTop_toBottomOf="@id/bottomDivider">

            <!-- Status Chip -->
            <com.google.android.material.chip.Chip
                android:id="@+id/statusChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:focusable="false"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                app:chipBackgroundColor="@color/status_approved"
                app:chipCornerRadius="12dp"
                app:chipEndPadding="10dp"
                app:chipMinHeight="26dp"
                app:chipStartPadding="10dp"
                app:elevation="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Approved" />

            <!-- View Details Pill Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_viewAppliedAddAttendance"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:contentDescription="View More btn"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="View"
                android:textAllCaps="false"
                android:textColor="#4F46E5"
                android:textSize="12sp"
                app:cornerRadius="28dp"
                app:icon="@drawable/ic_eye"
                app:iconGravity="textStart"
                app:iconPadding="4dp"
                app:iconSize="16dp"
                app:iconTint="#4F46E5"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeColor="#4F46E5"
                app:strokeWidth="1.5dp" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
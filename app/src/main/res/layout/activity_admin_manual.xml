<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0F"
    android:fontFamily="@font/quicksand_font_family">

    <!-- ===== RESPONSIVE GUIDELINES ===== -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineLeft"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="@dimen/camera_guide_left" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineRight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="@dimen/camera_guide_right" />

    <!-- ===== HEADER ===== -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Live badge row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#12121C"
                app:cardCornerRadius="6dp"
                app:cardElevation="0dp"
                app:strokeColor="#2A2A3A"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp">

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/shape_pulse_dot" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="LIVE"
                        android:textColor="#5B5BFF"
                        android:textSize="@dimen/text_size_badge" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:lineSpacingExtra="2dp"
            android:text="Face\nVerification"
            android:textColor="#EEEEF8"
            android:textSize="@dimen/text_size_title" />

        <!-- Accent line -->
        <View
            android:layout_width="48dp"
            android:layout_height="2dp"
            android:layout_marginTop="12dp"
            android:background="#5B5BFF" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="monospace"
            android:text="Manual visitor registration"
            android:textColor="#4A4A6A"
            android:textSize="@dimen/text_size_subtitle" />
    </LinearLayout>

    <!-- ===== CAMERA CIRCLE ===== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cameraCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardBackgroundColor="#12121C"
        app:cardCornerRadius="9999dp"
        app:cardElevation="0dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toStartOf="@id/guidelineRight"
        app:layout_constraintStart_toEndOf="@id/guidelineLeft"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:strokeColor="#5B5BFF"
        app:strokeWidth="2dp">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Camera preview for face detection" />

        <View
            android:id="@+id/scannerLine"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#5B5BFF"
            android:visibility="gone" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Corner scan decorators -->
    <View
        android:layout_width="@dimen/corner_long"
        android:layout_height="@dimen/corner_short"
        android:layout_marginStart="@dimen/corner_margin"
        android:layout_marginTop="@dimen/corner_margin"
        android:alpha="0.6"
        android:background="#5B5BFF"
        app:layout_constraintStart_toStartOf="@id/cameraCard"
        app:layout_constraintTop_toTopOf="@id/cameraCard" />

    <View
        android:layout_width="@dimen/corner_short"
        android:layout_height="@dimen/corner_long"
        android:layout_marginTop="@dimen/corner_margin"
        android:layout_marginEnd="@dimen/corner_margin"
        android:alpha="0.6"
        android:background="#5B5BFF"
        app:layout_constraintEnd_toEndOf="@id/cameraCard"
        app:layout_constraintTop_toTopOf="@id/cameraCard" />

    <View
        android:layout_width="@dimen/corner_long"
        android:layout_height="@dimen/corner_short"
        android:layout_marginStart="@dimen/corner_margin"
        android:layout_marginBottom="@dimen/corner_margin"
        android:alpha="0.6"
        android:background="#5B5BFF"
        app:layout_constraintBottom_toBottomOf="@id/cameraCard"
        app:layout_constraintStart_toStartOf="@id/cameraCard" />

    <View
        android:layout_width="@dimen/corner_short"
        android:layout_height="@dimen/corner_long"
        android:layout_marginEnd="@dimen/corner_margin"
        android:layout_marginBottom="@dimen/corner_margin"
        android:alpha="0.6"
        android:background="#5B5BFF"
        app:layout_constraintBottom_toBottomOf="@id/cameraCard"
        app:layout_constraintEnd_toEndOf="@id/cameraCard" />

    <!-- ===== STATUS MODULE ===== -->
    <LinearLayout
        android:id="@+id/statusModule"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        app:layout_constraintBottom_toTopOf="@id/footerText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cameraCard"
        app:layout_constraintVertical_bias="0.3">

        <!-- Scanning dot + label -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/shape_pulse_dot" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.25"
                android:text="SCANNING"
                android:textColor="#5B5BFF"
                android:textSize="@dimen/text_size_badge" />
        </LinearLayout>

        <!-- capture_overlay inside card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#12121C"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:strokeColor="#1A5B5BFF"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/capture_overlay"
                android:layout_width="@dimen/capture_overlay_width"
                android:layout_height="wrap_content"
                android:fontFamily="@font/quicksand_font_family"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:paddingHorizontal="20dp"
                android:paddingVertical="14dp"
                android:text="@string/capturing_image"
                android:textColor="#EEEEF8"
                android:textSize="@dimen/text_size_capture"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />

        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- ===== FOOTER ===== -->
    <TextView
        android:id="@+id/footerText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="48dp"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="Your data is processed securely\nand never stored on this device."
        android:textColor="#3A3A5A"
        android:textSize="@dimen/text_size_footer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- ===== FORM OVERLAY (LIGHT THEME — modern redesign) ===== -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/formScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#F5F7FB"
        android:clipToPadding="false"
        android:elevation="8dp"
        android:fillViewport="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="28dp"
            android:paddingBottom="32dp">

            <!-- ===== HERO HEADER ===== -->
            <LinearLayout
                android:id="@+id/headerCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="28dp"
                android:orientation="vertical">

                <!-- Accent bar -->
                <View
                    android:layout_width="40dp"
                    android:layout_height="4dp"
                    android:layout_marginBottom="14dp"
                    android:background="#4F46E5" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Meeting Request"
                    android:textColor="#111827"
                    android:textSize="28sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif"
                    android:text="Please fill in your details to schedule a meeting"
                    android:textColor="#6B7280"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- ===== SECTION 1: VISITOR INFORMATION ===== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/formCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="22dp"
                    android:paddingBottom="8dp">

                    <!-- Section Title -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:layout_marginEnd="10dp"
                            android:background="#4F46E5" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.12"
                            android:text="VISITOR INFORMATION"
                            android:textAllCaps="true"
                            android:textColor="#4F46E5"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Name -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/nameInputLayout"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="18dp"
                        android:hint="Full Name"
                        android:textColorHint="#9CA3AF"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="#4F46E5"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="2dp"
                        app:hintTextColor="#4F46E5"
                        app:startIconDrawable="@drawable/ic_person"
                        app:startIconTint="#4F46E5">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/nameEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPersonName"
                            android:paddingVertical="14dp"
                            android:textColor="#111827"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Contact -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/contactInputLayout"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="18dp"
                        android:hint="Contact Number"
                        android:textColorHint="#9CA3AF"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="#4F46E5"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="2dp"
                        app:hintTextColor="#4F46E5"
                        app:startIconDrawable="@drawable/ic_phone"
                        app:startIconTint="#4F46E5">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/contactEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="phone"
                            android:paddingVertical="14dp"
                            android:textColor="#111827"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Email -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/emailInputLayout"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="18dp"
                        android:hint="Email Address"
                        android:textColorHint="#9CA3AF"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="#4F46E5"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="2dp"
                        app:hintTextColor="#4F46E5"
                        app:startIconDrawable="@drawable/ic_email"
                        app:startIconTint="#4F46E5">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/emailEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textEmailAddress"
                            android:paddingVertical="14dp"
                            android:textColor="#111827"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Company -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/companyInputLayout"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="18dp"
                        android:hint="Company Name"
                        android:textColorHint="#9CA3AF"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="#4F46E5"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="2dp"
                        app:hintTextColor="#4F46E5"
                        app:startIconDrawable="@drawable/ic_business"
                        app:startIconTint="#4F46E5">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/companyEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:paddingVertical="14dp"
                            android:textColor="#111827"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== SECTION 2: MEETING DETAILS ===== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="28dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="22dp"
                    android:paddingBottom="8dp">

                    <!-- Section Title -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:layout_marginEnd="10dp"
                            android:background="#4F46E5" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.12"
                            android:text="MEETING DETAILS"
                            android:textAllCaps="true"
                            android:textColor="#4F46E5"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Whom to Meet -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/whomToMeetInputLayout"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="18dp"
                        android:hint="Whom to Meet"
                        android:textColorHint="#9CA3AF"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="#4F46E5"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="2dp"
                        app:hintTextColor="#4F46E5"
                        app:startIconDrawable="@drawable/ic_group"
                        app:startIconTint="#4F46E5">

                        <MultiAutoCompleteTextView
                            android:id="@+id/whomToMeetAutoComplete"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:paddingVertical="14dp"
                            android:textColor="#111827"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Purpose -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/purposeInputLayout"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="18dp"
                        android:hint="Purpose of Meeting"
                        android:textColorHint="#9CA3AF"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="#4F46E5"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="2dp"
                        app:hintTextColor="#4F46E5"
                        app:startIconDrawable="@drawable/ic_description"
                        app:startIconTint="#4F46E5">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/purposeEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textMultiLine"
                            android:maxLines="5"
                            android:minLines="2"
                            android:paddingVertical="14dp"
                            android:textColor="#111827"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Device -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/deviceInputLayout"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="18dp"
                        android:hint="Bringing Laptop?"
                        android:textColorHint="#9CA3AF"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="#4F46E5"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="2dp"
                        app:hintTextColor="#4F46E5"
                        app:startIconDrawable="@drawable/ic_devices"
                        app:startIconTint="#4F46E5">

                        <AutoCompleteTextView
                            android:id="@+id/deviceAutoComplete"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:paddingVertical="14dp"
                            android:textColor="#111827"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Serial Number (Hidden by Default) -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/serialNumberLayout"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="18dp"
                        android:hint="Laptop Serial Number"
                        android:textColorHint="#9CA3AF"
                        android:visibility="gone"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="#4F46E5"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="2dp"
                        app:hintTextColor="#4F46E5"
                        app:startIconTint="#4F46E5">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/serialNumber"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:paddingVertical="14dp"
                            android:textColor="#111827"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== CTA BUTTON ===== -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/nextButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:backgroundTint="#4F46E5"
                android:letterSpacing="0.05"
                android:text="NEXT"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="16dp"
                app:elevation="4dp"
                app:icon="@drawable/animated_arrow"
                app:iconGravity="end"
                app:iconPadding="8dp"
                app:iconTint="#FFFFFF" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
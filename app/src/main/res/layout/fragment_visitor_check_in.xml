<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/visitor_check_in_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".adminUI.Visitor.VisitorCheckInFragment">

    <!-- ===== Full screen gradient background ===== -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/gradient_checkin_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Decorative top-right circle blob -->
    <View
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_marginTop="-80dp"
        android:layout_marginEnd="-80dp"
        android:alpha="0.08"
        android:background="@drawable/circle_shape"
        android:backgroundTint="@color/surface_white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Decorative bottom-left circle blob -->
    <View
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_marginStart="-60dp"
        android:layout_marginBottom="-60dp"
        android:alpha="0.06"
        android:background="@drawable/circle_shape"
        android:backgroundTint="@color/surface_white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- ===== Scrollable Content ===== -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/min_screen_height">

            <!-- ===== Main Content Card ===== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/main_content_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/screen_padding_horizontal"
                android:layout_marginVertical="32dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.45"
                app:layout_constraintWidth_max="@dimen/max_content_width"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_white_rounded"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/card_padding_horizontal"
                    android:paddingVertical="@dimen/card_padding_vertical">

                    <!-- ===== Logo — plain, no wrapper ===== -->
                    <ImageView
                        android:id="@+id/company_logo"
                        android:layout_width="@dimen/logo_size"
                        android:layout_height="@dimen/logo_size"
                        android:contentDescription="@string/consultedge_global"
                        android:scaleType="centerInside"
                        android:src="@mipmap/ceg_logo" />

                    <!-- Welcome text -->
                    <TextView
                        android:id="@+id/welcome_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/welcome_text_margin_top"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:letterSpacing="0.02"
                        android:text="Welcome "
                        android:textColor="@color/primary_dark"
                        android:textSize="@dimen/welcome_text_size"
                        android:textStyle="bold" />

                    <!-- Accent divider -->
                    <View
                        android:layout_width="48dp"
                        android:layout_height="3dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="8dp"
                        android:alpha="0.15"
                        android:background="@drawable/bg_detail_chip"
                        android:backgroundTint="@color/primary_dark" />

                    <!-- Instruction label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="@dimen/buttons_margin_top"
                        android:gravity="center"
                        android:text="Select an action to continue"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <!-- ===== Action Buttons — original @dimen sizes, circular design ===== -->
                    <LinearLayout
                        android:id="@+id/buttons_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/buttons_margin_bottom"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <!-- ===== 1. Punch Out (Check Out) ===== -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/button_spacing"
                            android:gravity="center"
                            android:orientation="vertical">

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/punch_out_button"
                                android:layout_width="@dimen/action_button_size"
                                android:layout_height="@dimen/action_button_size"
                                android:clickable="true"
                                android:focusable="true"
                                app:cardBackgroundColor="@android:color/transparent"
                                app:cardCornerRadius="@dimen/action_button_corner_radius"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/gradient_punch"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:padding="@dimen/action_button_padding">

                                    <ImageView
                                        android:layout_width="@dimen/action_icon_size"
                                        android:layout_height="@dimen/action_icon_size"
                                        android:contentDescription="@string/punch_out"
                                        android:scaleType="centerInside"
                                        android:src="@mipmap/punch_out" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/action_text_margin_top"
                                        android:gravity="center"
                                        android:text="@string/punch_out"
                                        android:textColor="@color/surface_white"
                                        android:textSize="@dimen/action_text_size"
                                        android:textStyle="bold" />

                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                        </LinearLayout>

                        <!-- ===== 2. Punch In (Check In) ===== -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/button_spacing"
                            android:gravity="center"
                            android:orientation="vertical">

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/punch_in_button"
                                android:layout_width="@dimen/action_button_size"
                                android:layout_height="@dimen/action_button_size"
                                android:clickable="true"
                                android:focusable="true"
                                app:cardBackgroundColor="@android:color/transparent"
                                app:cardCornerRadius="@dimen/action_button_corner_radius"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/gradient_punch"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:padding="@dimen/action_button_padding">

                                    <ImageView
                                        android:layout_width="@dimen/action_icon_size"
                                        android:layout_height="@dimen/action_icon_size"
                                        android:contentDescription="@string/punch_in"
                                        android:scaleType="centerInside"
                                        android:src="@mipmap/punch" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/action_text_margin_top"
                                        android:gravity="center"
                                        android:text="@string/punch_in"
                                        android:textColor="@color/surface_white"
                                        android:textSize="@dimen/action_text_size"
                                        android:textStyle="bold" />

                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                        </LinearLayout>

                        <!-- ===== 3. Manual Check-In ===== -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical">

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/manual_checkIn_button"
                                android:layout_width="@dimen/action_button_size"
                                android:layout_height="@dimen/action_button_size"
                                android:clickable="true"
                                android:focusable="true"
                                app:cardBackgroundColor="@android:color/transparent"
                                app:cardCornerRadius="@dimen/action_button_corner_radius"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/gradient_punch"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:padding="@dimen/action_button_padding">

                                    <ImageView
                                        android:layout_width="@dimen/action_icon_size"
                                        android:layout_height="@dimen/action_icon_size"
                                        android:contentDescription="@string/manual_check_in"
                                        android:scaleType="centerInside"
                                        android:src="@mipmap/punch" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/action_text_margin_top"
                                        android:gravity="center"
                                        android:text="@string/manual_check_in"
                                        android:textColor="@color/surface_white"
                                        android:textSize="@dimen/action_text_size"
                                        android:textStyle="bold" />

                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Footer -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:alpha="0.5"
                android:text="@string/_2024_powered_by_xe_digital"
                android:textColor="@color/surface_white"
                android:textSize="11sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <!-- ===== Loading Overlay ===== -->
    <FrameLayout
        android:id="@+id/loading_animation"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/overlay_scrim"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="gone">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            app:cardBackgroundColor="@color/surface_white"
            app:cardCornerRadius="24dp"
            app:cardElevation="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="28dp">

                <ProgressBar
                    android:id="@+id/progress_bar"
                    android:layout_width="@dimen/progress_bar_size"
                    android:layout_height="@dimen/progress_bar_size"
                    android:indeterminateTint="@color/primary_dark" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="Please wait..."
                    android:textColor="@color/primary_dark"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="Loading..."
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/loading_text_size" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
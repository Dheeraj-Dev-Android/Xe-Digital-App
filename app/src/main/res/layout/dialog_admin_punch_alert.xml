<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dialogCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp"
    app:cardBackgroundColor="#12121C"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:strokeColor="#2A2A3A"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:paddingTop="32dp"
        android:paddingBottom="8dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/dialogIconCircle"
            android:layout_width="@dimen/dialog_icon_size"
            android:layout_height="@dimen/dialog_icon_size"
            android:layout_gravity="center_horizontal"
            app:cardCornerRadius="999dp"
            app:cardElevation="0dp">

            <TextView
                android:id="@+id/dialogIconText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:textSize="@dimen/dialog_icon_text_size"
                tools:text="✓" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/dialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-light"
            android:gravity="center"
            android:textColor="#EEEEF8"
            android:textSize="@dimen/dialog_title_size"
            tools:text="Attendance Success" />

        <TextView
            android:id="@+id/dialogMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:textColor="#8A8FA6"
            android:textSize="@dimen/dialog_message_size"
            tools:text="Your check-in has been recorded successfully at the front office." />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="26dp"
            android:background="#2A2A3A" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/dialogNegativeButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:gravity="center"
                android:letterSpacing="0.05"
                android:paddingVertical="18dp"
                android:textColor="#5A5A72"
                android:textSize="@dimen/dialog_button_text_size"
                android:textStyle="bold"
                tools:text="CANCEL" />

            <View
                android:id="@+id/dialogButtonDivider"
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#2A2A3A" />

            <TextView
                android:id="@+id/dialogPositiveButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:gravity="center"
                android:letterSpacing="0.05"
                android:paddingVertical="18dp"
                android:textSize="@dimen/dialog_button_text_size"
                android:textStyle="bold"
                tools:text="OK" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
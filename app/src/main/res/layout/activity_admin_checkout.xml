<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_frame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0F"
    android:fontFamily="@font/quicksand_font_family"
    tools:context="admin.adminActivity.AdminCheckOutActivity">

    <!-- ===== RESPONSIVE GUIDELINES ===== -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineLeft"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="@dimen/camera_guide_left" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineRight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="@dimen/camera_guide_right" />

    <!-- ===== HEADER ===== -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Live badge row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#12121C"
                app:cardCornerRadius="6dp"
                app:cardElevation="0dp"
                app:strokeColor="#2A2A3A"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp">

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/shape_pulse_dot" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="LIVE"
                        android:textColor="#5B5BFF"
                        android:textSize="@dimen/text_size_badge" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:lineSpacingExtra="2dp"
            android:text="Face\nVerification"
            android:textColor="#EEEEF8"
            android:textSize="@dimen/text_size_title" />

        <!-- Accent line -->
        <View
            android:layout_width="48dp"
            android:layout_height="2dp"
            android:layout_marginTop="12dp"
            android:background="#5B5BFF" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="monospace"
            android:text="Visitor check-out"
            android:textColor="#4A4A6A"
            android:textSize="@dimen/text_size_subtitle" />
    </LinearLayout>

    <!-- ===== CAMERA CIRCLE ===== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cameraCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardBackgroundColor="#12121C"
        app:cardCornerRadius="9999dp"
        app:cardElevation="0dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toStartOf="@id/guidelineRight"
        app:layout_constraintStart_toEndOf="@id/guidelineLeft"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:strokeColor="#5B5BFF"
        app:strokeWidth="2dp">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Camera preview for face detection" />

        <View
            android:id="@+id/scannerLine"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#5B5BFF"
            android:visibility="gone" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Corner scan decorators -->
    <View
        android:layout_width="@dimen/corner_long"
        android:layout_height="@dimen/corner_short"
        android:layout_marginStart="@dimen/corner_margin"
        android:layout_marginTop="@dimen/corner_margin"
        android:alpha="0.6"
        android:background="#5B5BFF"
        app:layout_constraintStart_toStartOf="@id/cameraCard"
        app:layout_constraintTop_toTopOf="@id/cameraCard" />

    <View
        android:layout_width="@dimen/corner_short"
        android:layout_height="@dimen/corner_long"
        android:layout_marginTop="@dimen/corner_margin"
        android:layout_marginEnd="@dimen/corner_margin"
        android:alpha="0.6"
        android:background="#5B5BFF"
        app:layout_constraintEnd_toEndOf="@id/cameraCard"
        app:layout_constraintTop_toTopOf="@id/cameraCard" />

    <View
        android:layout_width="@dimen/corner_long"
        android:layout_height="@dimen/corner_short"
        android:layout_marginStart="@dimen/corner_margin"
        android:layout_marginBottom="@dimen/corner_margin"
        android:alpha="0.6"
        android:background="#5B5BFF"
        app:layout_constraintBottom_toBottomOf="@id/cameraCard"
        app:layout_constraintStart_toStartOf="@id/cameraCard" />

    <View
        android:layout_width="@dimen/corner_short"
        android:layout_height="@dimen/corner_long"
        android:layout_marginEnd="@dimen/corner_margin"
        android:layout_marginBottom="@dimen/corner_margin"
        android:alpha="0.6"
        android:background="#5B5BFF"
        app:layout_constraintBottom_toBottomOf="@id/cameraCard"
        app:layout_constraintEnd_toEndOf="@id/cameraCard" />

    <!-- ===== STATUS MODULE ===== -->
    <LinearLayout
        android:id="@+id/statusModule"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        app:layout_constraintBottom_toTopOf="@id/footerText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cameraCard"
        app:layout_constraintVertical_bias="0.3">

        <!-- Scanning dot + label -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/shape_pulse_dot" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.25"
                android:text="SCANNING"
                android:textColor="#5B5BFF"
                android:textSize="@dimen/text_size_badge" />
        </LinearLayout>

        <!-- capture_overlay inside card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#12121C"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:strokeColor="#1A5B5BFF"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/capture_overlay"
                android:layout_width="@dimen/capture_overlay_width"
                android:layout_height="wrap_content"
                android:fontFamily="@font/quicksand_font_family"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:paddingHorizontal="20dp"
                android:paddingVertical="14dp"
                android:text="@string/capturing_image"
                android:textColor="#EEEEF8"
                android:textSize="@dimen/text_size_capture"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />

        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- ===== FOOTER ===== -->
    <TextView
        android:id="@+id/footerText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="48dp"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="Your data is processed securely\nand never stored on this device."
        android:textColor="#3A3A5A"
        android:textSize="@dimen/text_size_footer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- ===== LOADING OVERLAY ===== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/loadingPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:cardBackgroundColor="#E6000000"
        app:cardElevation="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <com.facebook.shimmer.ShimmerFrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="@dimen/spinner_size"
                    android:layout_height="@dimen/spinner_size"
                    app:cardBackgroundColor="#12121C"
                    app:cardCornerRadius="999dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#5B5BFF"
                    app:strokeWidth="1dp">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/progressBar"
                        android:layout_width="@dimen/spinner_inner_size"
                        android:layout_height="@dimen/spinner_inner_size"
                        android:layout_gravity="center"
                        android:contentDescription="Loading indicator"
                        android:indeterminate="true"
                        app:indicatorColor="#5B5BFF"
                        app:indicatorSize="@dimen/spinner_inner_size"
                        app:trackColor="#1A5B5BFF"
                        app:trackThickness="4dp" />

                </com.google.android.material.card.MaterialCardView>
            </com.facebook.shimmer.ShimmerFrameLayout>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/loadingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="sans-serif-light"
                android:letterSpacing="0.05"
                android:text="@string/wait_while_we_are_getting_details"
                android:textAlignment="center"
                android:textColor="#EEEEF8"
                android:textSize="@dimen/text_size_loading" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:text="Please hold still"
                android:textColor="#4A4A6A"
                android:textSize="@dimen/text_size_subtitle" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Accent bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="#4F46E5" />

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:fontFamily="sans-serif-medium"
        android:text="Confirm Check-in"
        android:textColor="#111827"
        android:textSize="22sp" />

    <!-- Subtitle -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="20dp"
        android:fontFamily="sans-serif"
        android:text="Verify your captured photo before proceeding"
        android:textColor="#6B7280"
        android:textSize="13sp" />

    <!-- Image Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="4dp"
        app:strokeColor="#E0E7FF"
        app:strokeWidth="2dp">

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:contentDescription="Visitor captured photo"
            android:scaleType="centerCrop"
            android:src="@drawable/welcome_background" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Confirm Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/confirmButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:backgroundTint="#4F46E5"
        android:letterSpacing="0.03"
        android:text="Confirm Check-in"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="16dp"
        app:elevation="4dp"
        app:icon="@drawable/animated_arrow"
        app:iconGravity="end"
        app:iconPadding="8dp"
        app:iconTint="#FFFFFF" />

</LinearLayout>
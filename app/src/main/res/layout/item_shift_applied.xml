<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/surface_color"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ============ GRADIENT HEADER ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/gradient_attendance_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:id="@+id/ivProfile"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/circular_background"
                android:importantForAccessibility="no"
                android:padding="4dp"
                android:src="@drawable/ic_profile_placeholder" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <!-- Value: Name -->
                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/quicksand_font_family"
                    android:maxLines="1"
                    android:textColor="@color/attendance_card_text"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="John Doe" />

                <!-- Value: Email with icon -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="11dp"
                        android:layout_height="11dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_email"
                        app:tint="@color/attendance_card_subtext" />

                    <TextView
                        android:id="@+id/tvEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/quicksand_font_family"
                        android:maxLines="1"
                        android:textColor="@color/attendance_card_text"
                        android:textSize="12sp"
                        tools:text="john.doe@xedigital.ai" />
                </LinearLayout>

                <!-- Value: Contact with icon -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="11dp"
                        android:layout_height="11dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_phone"
                        app:tint="@color/attendance_card_subtext" />

                    <TextView
                        android:id="@+id/tvContactNumber"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="@font/quicksand_font_family"
                        android:textColor="@color/attendance_card_text"
                        android:textSize="12sp"
                        tools:text="+91 98765 43210" />
                </LinearLayout>

            </LinearLayout>

            <!-- Status Chip -->
            <com.google.android.material.chip.Chip
                android:id="@+id/chipStatus"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:checkable="false"
                android:clickable="false"
                android:fontFamily="@font/quicksand_font_family"
                android:textSize="11sp"
                android:textStyle="bold"
                app:chipCornerRadius="15dp"
                app:chipMinHeight="28dp"
                app:chipStrokeWidth="0dp"
                tools:chipBackgroundColor="@color/pending_status_color"
                tools:text="Pending"
                tools:textColor="@color/white" />

        </LinearLayout>

        <!-- ============ BODY ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <!-- ======== CURRENT SHIFT ROW ======== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Shift Icon Badge -->
                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_icon_badge_shift">

                    <ImageView
                        android:id="@+id/ivShift"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_shift"
                        app:tint="@color/icon_tint" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- Section Label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/quicksand_font_family"
                        android:letterSpacing="0.06"
                        android:text="Current Shift"
                        android:textAllCaps="true"
                        android:textColor="@color/icon_tint"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <!-- Info Label: Shift Time -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/quicksand_font_family"
                        android:text="Shift Time"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />

                    <!-- Value: Shift Time -->
                    <TextView
                        android:id="@+id/shiftTimeCurrent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:fontFamily="@font/quicksand_font_family"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="Morning (11:00 - 20:00)" />

                    <!-- Info Label: Shift Type -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/quicksand_font_family"
                        android:text="Shift Type"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />

                    <!-- Value: Shift Type -->
                    <TextView
                        android:id="@+id/tvShiftType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:fontFamily="@font/quicksand_font_family"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="General Shift" />

                </LinearLayout>
            </LinearLayout>

            <!-- Divider -->
            <View
                android:id="@+id/divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="12dp"
                android:background="@color/divider_color" />

            <!-- ======== REQUESTED UPDATE ROW ======== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Calendar Icon Badge -->
                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_icon_badge_calendar">

                    <ImageView
                        android:id="@+id/ivCalendar"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_calendar"
                        app:tint="@color/time_overtime" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- Section Label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/quicksand_font_family"
                        android:letterSpacing="0.06"
                        android:text="Requested Update"
                        android:textAllCaps="true"
                        android:textColor="@color/time_overtime"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <!-- Info Label: New Shift -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/quicksand_font_family"
                        android:text="New Shift"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />

                    <!-- Value: Shift Update -->
                    <TextView
                        android:id="@+id/tvShiftUpdate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:fontFamily="@font/quicksand_font_family"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="Evening (14:00 - 23:00)" />

                    <!-- Info Label: Requested Date -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/quicksand_font_family"
                        android:text="Requested Date"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />

                    <!-- Value: Requested Date -->
                    <TextView
                        android:id="@+id/tvRequestedDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:fontFamily="@font/quicksand_font_family"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="15-02-2024" />

                </LinearLayout>
            </LinearLayout>

            <!-- ======== APPROVAL STRIP ======== -->
            <LinearLayout
                android:id="@+id/approvalStripContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_approval_strip"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone"
                tools:visibility="visible">

                <!-- Section Label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/quicksand_font_family"
                    android:letterSpacing="0.06"
                    android:text="Update Details"
                    android:textAllCaps="true"
                    android:textColor="@color/status_approved"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <!-- Same Row: Updated By | Updated Date -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <!-- LEFT: Updated By -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <!-- Info Label -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/quicksand_font_family"
                            android:text="Updated By"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp" />

                        <!-- Value -->
                        <TextView
                            android:id="@+id/tvApprovedBy"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:fontFamily="@font/quicksand_font_family"
                            android:maxLines="1"
                            android:textColor="@color/status_approved"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            tools:text="Jane Smith" />

                    </LinearLayout>

                    <!-- Vertical Separator -->
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:layout_marginHorizontal="12dp"
                        android:background="@color/divider_color" />

                    <!-- RIGHT: Updated Date -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <!-- Info Label -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/quicksand_font_family"
                            android:text="Updated Date"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp" />

                        <!-- Value -->
                        <TextView
                            android:id="@+id/tvApprovedDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/quicksand_font_family"
                            android:textColor="@color/status_approved"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="22-02-2024" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
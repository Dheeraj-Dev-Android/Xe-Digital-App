<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fragment_dashboard_bg"
    tools:context=".ui.shifts.ShiftsFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/screenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:letterSpacing="-0.02"
            android:text="Shift Change Request"
            android:textColor="@color/white"
            android:textSize="26sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/screenSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Request a new shift or check pending requests"
            android:textColor="@color/color_white"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/screenTitle" />

        <!-- Segmented Navigation Chips -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/statusChipGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:chipSpacingHorizontal="10dp"
            app:layout_constraintTop_toBottomOf="@id/screenSubtitle"
            app:singleLine="true"
            app:singleSelection="false">

            <com.google.android.material.chip.Chip
                android:id="@+id/viewAppliedShiftsChip"
                style="@style/Widget.MaterialComponents.Chip.Action"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="📋  Applied Shifts"
                android:textColor="#1A1A2E"
                android:textSize="13sp"
                android:textStyle="bold"
                app:chipBackgroundColor="#FFFFFF"
                app:chipCornerRadius="22dp"
                app:chipStrokeColor="#E5E7EB"
                app:chipStrokeWidth="1.5dp"
                app:rippleColor="#E0E7FF" />

            <com.google.android.material.chip.Chip
                android:id="@+id/pendingApprovalChip"
                style="@style/Widget.MaterialComponents.Chip.Action"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="⏳  Pending Approval"
                android:textColor="#1A1A2E"
                android:textSize="13sp"
                android:textStyle="bold"
                app:chipBackgroundColor="#FFFFFF"
                app:chipCornerRadius="22dp"
                app:chipStrokeColor="#E5E7EB"
                app:chipStrokeWidth="1.5dp"
                app:rippleColor="#FEF3C7" />
        </com.google.android.material.chip.ChipGroup>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/headerSection"
        tools:ignore="MissingConstraints" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/buttonLayout"
        app:layout_constraintTop_toBottomOf="@id/headerSection">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/identityCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:cardPreventCornerOverlap="true"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeWidth="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/gradient_attendance_card"
                    android:padding="20dp">

                    <!-- Circular Profile Image Container -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/avatarCard"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        app:cardBackgroundColor="#22FFFFFF"
                        app:cardCornerRadius="32dp"
                        app:cardElevation="0dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:strokeColor="#40FFFFFF"
                        app:strokeWidth="1.5dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/avatarImageView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_profile_placeholder"
                            app:shapeAppearanceOverlay="@style/CircleImageView" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/identityLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:letterSpacing="0.15"
                        android:text="REQUESTING AS"
                        android:textColor="#D1D5DB"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/avatarCard"
                        app:layout_constraintTop_toTopOf="@id/avatarCard" />

                    <!-- Hidden fields for ViewBinding compatibility -->
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/firstNameEditText"
                        android:layout_width="1dp"
                        android:layout_height="1dp"
                        android:enabled="false"
                        android:inputType="textPersonName"
                        android:visibility="invisible"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/lastNameEditText"
                        android:layout_width="1dp"
                        android:layout_height="1dp"
                        android:enabled="false"
                        android:inputType="textPersonName"
                        android:visibility="invisible"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- User's Full Name Display -->
                    <TextView
                        android:id="@+id/userNameDisplay"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Employee Name"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/avatarCard"
                        app:layout_constraintTop_toBottomOf="@id/identityLabel" />

                    <!-- Separator Line -->
                    <View
                        android:id="@+id/identityDivider"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="18dp"
                        android:background="#26FFFFFF"
                        app:layout_constraintTop_toBottomOf="@id/avatarCard" />

                    <!-- Email Field -->
                    <TextView
                        android:id="@+id/emailInfoLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:letterSpacing="0.1"
                        android:text="EMAIL ADDRESS"
                        android:textColor="#D1D5DB"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/identityDivider" />

                    <TextView
                        android:id="@+id/emailIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:drawableStart="@drawable/ic_email"
                        android:drawableTint="@color/white"
                        android:text=""
                        android:textSize="14sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/emailInfoLabel" />

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/emailEditText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:background="@android:color/transparent"
                        android:ellipsize="end"
                        android:enabled="false"
                        android:hint="your.email@company.com"
                        android:inputType="textEmailAddress"
                        android:maxLines="1"
                        android:paddingVertical="0dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#9CA3AF"
                        android:textSize="14sp"
                        app:layout_constraintBottom_toBottomOf="@id/emailIcon"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/emailIcon"
                        app:layout_constraintTop_toTopOf="@id/emailIcon" />

                    <!-- Phone Field -->
                    <TextView
                        android:id="@+id/contactInfoLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:letterSpacing="0.1"
                        android:text="CONTACT NUMBER"
                        android:textColor="#D1D5DB"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/emailIcon" />

                    <TextView
                        android:id="@+id/contactIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:drawableStart="@drawable/ic_phone"
                        android:drawableTint="@color/white"
                        android:text=""
                        android:textSize="14sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/contactInfoLabel" />

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/contactEditText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:background="@android:color/transparent"
                        android:ellipsize="end"
                        android:enabled="false"
                        android:hint="+91 XXXXX XXXXX"
                        android:inputType="phone"
                        android:maxLines="1"
                        android:paddingVertical="0dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#9CA3AF"
                        android:textSize="14sp"
                        app:layout_constraintBottom_toBottomOf="@id/contactIcon"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/contactIcon"
                        app:layout_constraintTop_toTopOf="@id/contactIcon" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ================================ -->
            <!-- SECTION LABEL                    -->
            <!-- ================================ -->
            <TextView
                android:id="@+id/sectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:letterSpacing="0.15"
                android:text="SHIFT PREFERENCE"
                android:textColor="@color/color_white"
                android:textSize="11sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/identityCard" />

            <TextView
                android:id="@+id/sectionHelperText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="2dp"
                android:text="Choose the type of shift you want, then pick your preferred timing"
                android:textColor="@color/color_white"
                android:textSize="13sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/sectionLabel" />

            <!-- ================================ -->
            <!-- SHIFT SELECTION - Step 1         -->
            <!-- ================================ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/shiftTypeCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@id/sectionHelperText"
                app:strokeColor="#E5E7EB"
                app:strokeWidth="1.5dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="18dp">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/stepOneBadge"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        app:cardBackgroundColor="@color/accent_employee"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="1"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/stepOneTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Shift Type"
                        android:textColor="#1A1A2E"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="@id/stepOneBadge"
                        app:layout_constraintStart_toEndOf="@id/stepOneBadge"
                        app:layout_constraintTop_toTopOf="@id/stepOneBadge" />

                    <TextView
                        android:id="@+id/stepOneInfoText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="1dp"
                        android:text="Select the category of shift you're requesting (e.g., Morning, Evening, Night)"
                        android:textColor="#6B7280"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/stepOneBadge" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/shiftTypeTextInputLayout"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        app:boxBackgroundColor="#F9FAFB"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="@color/accent_employee"
                        app:boxStrokeWidth="0dp"
                        app:boxStrokeWidthFocused="2dp"
                        app:hintTextColor="#6B7280"
                        app:layout_constraintTop_toBottomOf="@id/stepOneInfoText">

                        <AutoCompleteTextView
                            android:id="@+id/shiftTypeSpinner"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:cursorVisible="false"
                            android:focusable="false"
                            android:hint="Select shift type"
                            android:imeActionLabel="Shift Type"
                            android:inputType="none"
                            android:paddingVertical="16dp"
                            android:textColor="#1A1A2E"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ================================ -->
            <!-- SHIFT TIMING - Step 2            -->
            <!-- ================================ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/shiftTimeCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@id/shiftTypeCard"
                app:strokeColor="#E5E7EB"
                app:strokeWidth="1.5dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="18dp">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/stepTwoBadge"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        app:cardBackgroundColor="@color/accent_employee"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="2"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/stepTwoTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Shift Timing"
                        android:textColor="#1A1A2E"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="@id/stepTwoBadge"
                        app:layout_constraintStart_toEndOf="@id/stepTwoBadge"
                        app:layout_constraintTop_toTopOf="@id/stepTwoBadge" />

                    <TextView
                        android:id="@+id/stepTwoInfoText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="1dp"
                        android:text="Pick the exact start and end time slot for your selected shift type"
                        android:textColor="#6B7280"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/stepTwoBadge" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/shiftTimeTextInputLayout"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        app:boxBackgroundColor="#F9FAFB"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="@color/accent_employee"
                        app:boxStrokeWidth="0dp"
                        app:boxStrokeWidthFocused="2dp"
                        app:hintTextColor="#6B7280"
                        app:layout_constraintTop_toBottomOf="@id/stepTwoInfoText">

                        <AutoCompleteTextView
                            android:id="@+id/shiftTimeSpinner"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:cursorVisible="false"
                            android:focusable="false"
                            android:hint="Select timing"
                            android:imeActionLabel="Shift Timing"
                            android:inputType="none"
                            android:paddingVertical="16dp"
                            android:textColor="#1A1A2E"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ================================ -->
            <!-- HR Info Callout                  -->
            <!-- ================================ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/hrInfoCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#FEF9E7"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@id/shiftTimeCard"
                app:strokeColor="#FDE68A"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/hrInfoIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📩"
                        android:textSize="18sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/hrInfoLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Notification will be sent to HR"
                        android:textColor="#78350F"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/hrInfoIcon"
                        app:layout_constraintTop_toTopOf="@id/hrInfoIcon" />

                    <TextView
                        android:id="@+id/hrInfoDescription"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="2dp"
                        android:text="Your request will be automatically forwarded to this email"
                        android:textColor="#92400E"
                        android:textSize="11sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/hrInfoIcon"
                        app:layout_constraintTop_toBottomOf="@id/hrInfoLabel" />

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/hrEmailEditText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="6dp"
                        android:background="@android:color/transparent"
                        android:ellipsize="end"
                        android:enabled="false"
                        android:hint="HR email will appear here"
                        android:inputType="textEmailAddress"
                        android:maxLines="1"
                        android:paddingVertical="0dp"
                        android:textColor="#78350F"
                        android:textColorHint="#B45309"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/hrInfoIcon"
                        app:layout_constraintTop_toBottomOf="@id/hrInfoDescription" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ============================================== -->
    <!-- FLOATING ACTION BAR                            -->
    <!-- ============================================== -->
    <LinearLayout
        android:id="@+id/buttonLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="14dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/clearButton"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:minWidth="100dp"
            android:text="Clear"
            android:textColor="#EF4444"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="26dp"
            app:rippleColor="#FEE2E2" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/submitButton"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:paddingHorizontal="32dp"
            android:text="Submit Request  →"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@color/accent_employee"
            app:cornerRadius="26dp"
            app:elevation="0dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>